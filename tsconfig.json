{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node", "vite/client", "@effect/ui/html/MarkdownContent"]
  },
  "include": ["src/**/*.ts", "vite.config.ts", "alchemy.run.ts"],
  "exclude": ["node_modules", "dist"]
}
